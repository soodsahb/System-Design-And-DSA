class Solution {
    static List<Integer> firstNegInt(int arr[], int k) {
       
       
       int i=0,j=0;
       
       Queue<Integer> q = new LinkedList<>();
       List<Integer> ans= new ArrayList<>();
       
       while(j<arr.length){
           
           if(arr[j]<0){
               q.offer(arr[j]);
           }
           
           if(j-i+1<k){
               
               j++;
           }else if(j-i+1==k){
               
               
               if(q.isEmpty()){
                  
                  ans.add(0); 
               }else{
                   
                   ans.add(q.peek());
               }
               
               if(!q.isEmpty()&&arr[i]==q.peek()){
                   q.poll();
                   
               }
               i++;
               j++;
               
               
               
           }
       }
       
       return ans;
        
    }
}
